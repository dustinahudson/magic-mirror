#!/bin/sh
#
# Bring up WiFi.
#
# Deliberately thin: this script only performs the initial association.
# Keeping the link alive is the application's job (internal/netmon), because
# recovery needs to escalate — reassociate, restart the supplicant, reload the
# driver, and only then reboot. v1 went straight to reboot, and when that did
# not take, the only remaining tool was the power cable.

# Overridable so this can be tested without a radio; the defaults are the
# production values and nothing on the device sets them. This script decides
# whether the mirror is reachable at all, which makes "tested by deploying
# it" the most expensive possible way to find a bug in it.
BOOT="${MM_BOOT:-/boot}"
WPA_CONF="$BOOT/wpa_supplicant.conf"
RUNTIME_CONF="${MM_RUNTIME_CONF:-/var/run/wpa_supplicant.conf}"
IFACE="${MM_IFACE:-wlan0}"
NETLOG="$BOOT/logs/network.log"
SYSNET="${MM_SYSNET:-/sys/class/net}"
MODULES="${MM_MODULES:-/proc/modules}"

# Log to the SD card as well as the console. The console is the UART, which
# is only useful if someone has a serial adapter physically attached — and
# the times you most need this output are exactly the times nobody does.
say() {
  echo "network: $*"
  mkdir -p "$(dirname "$NETLOG")" 2>/dev/null
  echo "$(date '+%H:%M:%S') $*" >> "$NETLOG" 2>/dev/null || true
}

case "$1" in
  start)
    # Sanity-check the pseudo-filesystems before trusting anything below.
    #
    # Every interface check here reads /sys, and modprobe reads /proc. When
    # they were missing, this script confidently reported "wlan0 never
    # appeared" while the radio was up and running firmware — the most
    # misleading possible message. Say so plainly instead.
    [ -d /proc/self ] || say "WARNING /proc is not mounted; module state is unreadable"
    [ -d /sys/class ] || say "WARNING /sys is not mounted; interface detection cannot work"

    # Load the radio driver explicitly.
    #
    # Nothing else does. There is no udev here, and BusyBox mdev is not
    # configured to autoload modules from a modalias — so on the first real
    # boot wlan0 simply never appeared and every network layer above it
    # failed with no obvious cause.
    if ! grep -q '^brcmfmac ' "$MODULES" 2>/dev/null; then
      out=$(modprobe brcmfmac 2>&1)
      if [ $? -eq 0 ]; then
        say "loaded brcmfmac"
      else
        say "modprobe brcmfmac FAILED: $out"
      fi
    fi

    # Wait for the driver to probe the SDIO device and create the interface.
    for i in $(seq 1 50); do
      [ -d "$SYSNET/$IFACE" ] && break
      usleep 100000
    done

    if [ ! -d "$SYSNET/$IFACE" ]; then
      say "$IFACE never appeared after loading brcmfmac"
      say "modules: $(awk '{printf "%s ", $1}' "$MODULES" 2>/dev/null)"
      say "firmware: $(ls /lib/firmware/brcm/ 2>/dev/null | tr '\n' ' ')"
      say "net devices: $(ls "$SYSNET"/ 2>/dev/null | tr '\n' ' ')"
      say "dmesg brcm: $(dmesg 2>/dev/null | grep -i brcm | tail -5 | tr '\n' '|')"
      exit 0
    fi

    ip link set "$IFACE" up

    if [ ! -f "$WPA_CONF" ]; then
      # No credentials yet. The app detects this and starts the AP setup
      # portal, so booting without config is a supported state rather than
      # an error.
      say "no $WPA_CONF; leaving $IFACE up for provisioning"
      exit 0
    fi

    # Copy to a writable location: the app rewrites credentials via the
    # config UI, and the FAT partition is the durable copy while /var/run is
    # what the supplicant actually reads.
    cp "$WPA_CONF" "$RUNTIME_CONF"

    wpa_supplicant -B -i "$IFACE" -c "$RUNTIME_CONF" -D nl80211

    # DHCP in the background so a slow or absent server never delays boot.
    # The mirror should be drawing a clock within seconds regardless of
    # whether it has an address yet.
    udhcpc -b -i "$IFACE" -x hostname:magicmirror -t 5 -T 3 &

    # Sync the clock once an address exists.
    #
    # This runs in the background because it must not delay boot, but it is
    # load-bearing: with no RTC the device boots at 1970, and every HTTPS
    # request fails certificate validation until the time is right. NTP is
    # plain UDP with no certificate of its own, so it works from a wrong
    # clock — which is what makes it the bootstrap.
    (
      for i in $(seq 1 30); do
        [ -n "$(ip -4 addr show "$IFACE" 2>/dev/null | grep -o 'inet [0-9.]*')" ] && break
        sleep 1
      done
      if ntpd -q -n -p pool.ntp.org >/dev/null 2>&1; then
        say "clock synced: $(date -u '+%Y-%m-%d %H:%M:%S') UTC"
        # Write, rename, then sync. A bare redirect truncates the file first,
        # so losing power during it leaves a zero-length clock and the next
        # boot starts at the epoch with every HTTPS certificate "not yet
        # valid" until NTP comes back. That is exactly what this file exists
        # to prevent, and it has already happened once on a real card.
        if date -u +%Y%m%d%H%M.%S > "$BOOT/.clock.tmp" 2>/dev/null; then
          mv "$BOOT/.clock.tmp" "$BOOT/clock" 2>/dev/null && sync
        else
          rm -f "$BOOT/.clock.tmp" 2>/dev/null
        fi
      else
        say "NTP sync failed; running on the restored clock"
      fi
      # Then keep it disciplined in the background.
      ntpd -n -p pool.ntp.org >/dev/null 2>&1 &
    ) &
    ;;

  stop)
    killall udhcpc 2>/dev/null
    killall wpa_supplicant 2>/dev/null
    ip link set "$IFACE" down 2>/dev/null
    ;;

  restart|reload)
    "$0" stop
    sleep 1
    "$0" start
    ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

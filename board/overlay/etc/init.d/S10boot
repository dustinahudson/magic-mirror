#!/bin/sh
#
# Mount the FAT boot partition and prepare writable state.
#
# The FAT partition is the only real filesystem on the device: it holds the
# kernel, the app binary, the config, and all persistent state. The rootfs
# itself is a cpio in RAM, so nothing there survives a reboot and nothing
# there can be corrupted by one.

# Overridable so the mount and repair sequence can be tested without a card;
# the defaults are the production values and nothing on the device sets them.
# This is the first script that runs, and if it is wrong nothing after it
# happens at all.
BOOT_DEV="${MM_BOOT_DEV:-/dev/mmcblk0p1}"
BOOT_MNT="${MM_BOOT:-/boot}"
DEV_WAIT="${MM_DEV_WAIT:-50}"

case "$1" in
  start)
    printf 'Mounting boot partition: '

    mkdir -p "$BOOT_MNT"

    # Wait for the SD controller to enumerate. Without this the mount races
    # the mmc driver on a cold boot and loses about one time in five.
    for i in $(seq 1 "$DEV_WAIT"); do
      [ -b "$BOOT_DEV" ] && break
      usleep 100000
    done

    # Repair before mounting.
    #
    # FAT has no journal and this device gets unplugged rather than shut
    # down, so an interrupted write leaves the filesystem inconsistent.
    # Writing onto that inconsistency later can orphan an entire file's
    # clusters — which is exactly how kernel.img became a zero-byte file
    # and the mirror stopped booting entirely.
    if command -v fsck.vfat >/dev/null 2>&1; then
      fsck.vfat -a "$BOOT_DEV" >/dev/null 2>&1
      echo "checked, "
    fi

    if ! mount -t vfat -o rw,flush,noatime "$BOOT_DEV" "$BOOT_MNT"; then
      echo "FAILED"
      # Carry on booting anyway. A mirror that comes up with no config and
      # says so on screen is more useful than one that halts — and the
      # screen is the only diagnostic channel most of the time.
      exit 0
    fi
    echo "OK"

    # `flush` above makes writes hit the card promptly, which matters on a
    # device people unplug rather than shut down.

    mkdir -p "$BOOT_MNT/logs"

    # Cap the logs before anything starts appending to them.
    #
    # mm-supervise rotates its own log, but nothing rotated the network one —
    # and dropbear appends a line per connection attempt to it for as long as
    # the device runs. On a partition that also holds the configuration, the
    # kernel and every piece of persistent state, a log nobody bounds is a
    # mirror that eventually cannot save its own settings. One scanner on the
    # network is enough to get there.
    #
    # Done here because it is the one place that runs before the writers do.
    for log in "$BOOT_MNT"/logs/*.log; do
      [ -f "$log" ] || continue
      size=$(wc -c < "$log" 2>/dev/null || echo 0)
      if [ "$size" -gt "${MM_LOG_MAX_BYTES:-1048576}" ]; then
        mv "$log" "$log.1" 2>/dev/null && sync
      fi
    done
    ;;

  stop)
    umount "$BOOT_MNT" 2>/dev/null
    ;;

  restart|reload)
    "$0" stop
    "$0" start
    ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
